{
  "name": "enlightlayer-pitchdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Enlight Layer — pitch deck website",
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3210",
    "typecheck": "tsc --noEmit",
    "photos": "node scripts/process-photos.mjs",
    "pdf": "node scripts/export-pdf.mjs",
    "qa": "node scripts/qa.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"content/**/*.ts\" \"lib/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "dependencies": {
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  }
}
